pipeline {
    agent any

    stages {
        stage('Test Remote Connection') {

            environment {
                SERVIP = '192.168.50.125'
                REMOTE_CONECT = 'ssh -v -i /var/jenkins_home/.ssh/id_rsa jenkinsusr@192.168.50.125'
            }   
            steps {
                sh '''
                    echo "Connecting to server $SERVIP"
                '''
            }
        }
    }
}
