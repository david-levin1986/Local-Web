pipeline {
    agent any

    stages {
        stage('Test Remote Connection') {

            environment {
                SSH_KEY = '/var/jenkins_home/.ssh/id_rsa'
                REMOTE_USER = 'jenkinsusr'
                REMOTE_HOST = '192.168.50.125'
            }   
            steps {
                sh '''
                    echo "Connecting to server $SERVIP"
                        ssh -i $SSH_KEY $REMOTE_USER@$REMOTE_HOST <<'EOF'
                        echo "Chipopo form munki start" > /tmp/remotserver.txt
                        cat /tmp/remotserver.txt
                        echo "Doing another action on the remote server"
                        ls -l /tmp/remotserver.txt
                '''
            }
        }
    }
}
