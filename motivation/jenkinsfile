pipeline {
    agent any

    stages {
        stage('Test Remote Connection') {

            environment {
                SERVIP = '192.168.50.125'
            }   
            steps {
                sh '''
                    echo "Connecting to server $SERVIP"
                    ssh -v -i /var/jenkins_home/.ssh/id_rsa jenkinsusr@$SERVIP << 'ENDSSH'
                    'echo "test text" > /tmp/remotserver.txt'
                    cat /tmp/remotserver.txt'
                    ENDSSH
                '''
            }
        }
    }
}
