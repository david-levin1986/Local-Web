pipeline {
    agent any

    environment {
                SSH_KEY = '/var/jenkins_home/.ssh/id_rsa'
                REMOTE_USER = 'jenkinsusr'
                REMOTE_HOST = '192.168.50.125'
                WEB_SERVICE = 'motivation'
                
                
            }

    stages {
        /*
        stage('Test remot server') {

               
            steps {
                sh '''
                        echo "Connecting to server $SERVIP"
                        ssh -i $SSH_KEY $REMOTE_USER@$REMOTE_HOST <<'EOF'
                        echo "Chipopo he is the king" > /tmp/remotserver.txt
                        cat /tmp/remotserver.txt
                        echo "Doing another action on the remote server"
                        ls -l /tmp/remotserver.txt
                '''
            }
        }
        */
        stage('Install Prerequest') {
            steps {
                sh '''
                    
                    scp -i $SSH_KEY InstallWebService.sh $REMOTE_USER@$REMOTE_HOST:/tmp/InstallWebService.sh
                    scp -r -i $SSH_KEY $WEB_SERVICE $REMOTE_USER@$REMOTE_HOST:/tmp/
                    ssh -i $SSH_KEY $REMOTE_USER@$REMOTE_HOST <<'EOF'
                    chmod +x /tmp/InstallWebService.sh
                    /tmp/InstallWebService.sh                   
                '''
            }
        }
        stage('Deploy Web') {
            steps {
                sh '''
                    echo "$WEB_SERVICE"
                    ssh -i \$SSH_KEY \$REMOTE_USER@\$REMOTE_HOST \\
                    sudo rm -rf /var/www/html/*
                    sudo cp -r /tmp/$WEB_SERVICE/* /var/www/html/
                    sudo rm -rf /tmp/$WEB_SERVICE
                    sudo rm -rf /tmp/InstallWebService.sh 
                    
                '''
            }
        }
    }
}
